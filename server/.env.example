# Server-side only — NEVER shipped to the Flutter client.

# OneSignal credentials (Settings → Keys & IDs in the OneSignal dashboard)
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_REST_API_KEY=os_v2_app_xxxxxxxxxxxxxxxxxxxxxxxx

# Shared relay client token — abuse resistance for the public endpoint,
# NOT a high-security secret. The Flutter client sends it as
# `Authorization: Bearer <token>` (configured via
# --dart-define=VOXGUARD_RELAY_TOKEN). Production should move to
# authenticated users / device attestation.
RELAY_CLIENT_TOKEN=choose-a-long-random-string

# Comma-separated CORS origins. Defaults cover the GitHub Pages demo
# and local dev. Do not use *.
ALLOWED_ORIGINS=https://nemesisdevx.github.io,http://localhost,http://127.0.0.1
